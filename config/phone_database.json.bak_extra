  "edl_test_points": {
    "_description": "EDL mode test point locations for Qualcomm devices. Short the test point to GND while connecting USB cable (phone OFF).",
    "oneplus": {
      "OnePlus 9R": "Near SoC area on motherboard. Remove back cover → locate TP pad near main processor → short to ground with tweezer while plugging USB. Phone must be OFF.",
      "OnePlus 9": "Near SoC, similar location to 9R. Test point under EMI shield near CPU.",
      "OnePlus 9 Pro": "Near SoC, under EMI shield can B.",
      "OnePlus 8T": "TP near battery connector area.",
      "OnePlus 8": "Near SoC area, under main shield.",
      "OnePlus Nord": "Near SoC on back of motherboard."
    },
    "xiaomi": {
      "general": "Most Xiaomi Qualcomm devices: TP near SoC or eMMC/UFS. Check specific model on XDA/GSM forum.",
      "Redmi Note 10 Pro": "Near UFS chip, test point pad visible after removing back cover and shields.",
      "POCO F3": "Near SoC area under EMI shield."
    },
    "samsung": {
      "general": "Samsung Qualcomm variants: TP usually near CPU under EMI shield. Samsung Exynos devices do NOT have Qualcomm EDL mode — use Odin/Download mode instead.",
      "download_mode_key": "Volume Down + Power (with USB cable connected)"
    },
    "realme_oppo": {
      "general": "Realme/OPPO Qualcomm devices: TP near SoC. MediaTek devices use MTK bypass (BROM) instead of EDL.",
      "mtk_brom_mode": "For MediaTek devices: Short boot pin to GND during power on. Tool: SP Flash Tool or MTK Auth Bypass.",
      "Realme GT 2 Pro": "Qualcomm SM8450. TP near SoC under EMI shield, accessible after removing back panel and mid-frame shield.",
      "OPPO Find X5 Pro": "Qualcomm SM8450. TP pad near CPU area under main EMI shield.",
      "OPPO Reno 10 Pro+": "Qualcomm SM8475. TP near SoC, remove back cover and EMI can."
    },
    "vivo": {
      "general": "Vivo Qualcomm devices: TP near SoC area. Most Vivo phones use MediaTek, so use SP Flash Tool / MTK BROM bypass instead.",
      "mtk_brom_mode": "For MediaTek Vivo devices: Short boot pin to GND during power on. Use SP Flash Tool with MTK Auth Bypass.",
      "Vivo X80 Pro": "Qualcomm SM8450. TP near SoC under EMI shield. Remove back panel and shields to access.",
      "Vivo T1": "Qualcomm SM7325. TP near SoC area, accessible after removing back cover."
    },
    "motorola": {
      "general": "Motorola Qualcomm devices: TP near SoC. Many Moto G series use test point near CPU under EMI shield. Motorola also supports bootloader unlock via official site.",
      "Motorola Edge 50 Pro": "Qualcomm SM8475. TP near SoC under EMI shield. Remove back panel to access.",
      "Motorola Edge 40 Pro": "Qualcomm SM8550. TP near SoC area under main shield.",
      "Moto G34": "Qualcomm SM6225. TP near SoC, accessible after removing back panel and shields.",
      "Moto G84": "Qualcomm SM6225. TP near SoC area. Remove back cover and locate pad near processor."
    }
  },
  "brand_specific_tools": {
    "samsung": {
      "flash_tool": "Odin (Samsung official)",
      "download_mode_key": "Volume Down + Power (with cable)",
      "frp_bypass_notes": "Samsung FRP requires Samsung account or Google account. Knox may prevent bypass on newer devices."
    },
    "xiaomi": {
      "flash_tool": "MiFlash Tool / SP Flash Tool (MTK)",
      "edl_tool": "QFIL / MiFlash (Qualcomm)",
      "fastboot_key": "Volume Down + Power",
      "recovery_key": "Volume Up + Power",
      "frp_bypass_notes": "Xiaomi has Mi Account lock in addition to Google FRP. Both need to be removed."
    },
    "oneplus": {
      "flash_tool": "MSM Download Tool (EDL) / Fastboot",
      "edl_tool": "MSM Download Tool (Qualcomm specific)",
      "fastboot_key": "Volume Down + Power",
      "recovery_key": "Volume Down + Power (release at logo, keep Vol Down)",
      "frp_bypass_notes": "OnePlus allows bootloader unlock via developer options. MSM Tool flashes full firmware and removes all locks."
    },
    "realme_oppo": {
      "flash_tool": "MSM Download Tool (Qualcomm) / SP Flash Tool (MTK)",
      "fastboot_key": "Volume Down + Power",
      "recovery_key": "Volume Down + Power",
      "frp_bypass_notes": "ColorOS FRP can be bypassed via fastboot or EDL flash."
    },
    "vivo": {
      "flash_tool": "QFIL (Qualcomm) / SP Flash Tool (MTK)",
      "fastboot_key": "Volume Down + Power",
      "recovery_key": "Volume Up + Power (for some models)",
      "frp_bypass_notes": "Vivo/iQOO FRP requires full firmware flash in most cases."
    },
    "motorola": {
      "flash_tool": "Rescue & Smart Assistant (official) / Fastboot",
      "fastboot_key": "Volume Down + Power",
      "frp_bypass_notes": "Motorola allows bootloader unlock via official website."
    },
    "google": {
      "flash_tool": "Android Flash Tool (web) / Fastboot",
      "fastboot_key": "Volume Down + Power",
      "frp_bypass_notes": "Pixel FRP requires original Google account. Factory image flash via fastboot removes FRP."
    },
    "nothing": {
      "flash_tool": "Fastboot / Nothing official flash tool",
      "fastboot_key": "Volume Down + Power",
      "recovery_key": "Volume Down + Power (release at logo)",
      "frp_bypass_notes": "Nothing allows bootloader unlock via developer options. Fastboot flash removes locks."
    }
  },
  "repair_difficulty_guide": {
    "easy": "Screen replacement, battery swap, charging port change, speaker/mic replacement",
    "medium": "Charging IC replacement, backlight IC repair, FPC connector replacement, basic reball",
    "hard": "CPU/SoC reball, WiFi/BT IC replacement, RF IC repair, modem reball",
    "expert": "DRAM voltage regulator (fan53526/MT6691ZXP), NAND/UFS reball, baseband repair, board-level micro-soldering"
  }
}