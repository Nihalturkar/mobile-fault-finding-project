; Qualcomm HS-USB QDLoader 9008 Driver (WinUSB based)
; For Mooxy AI Mobile Repair Tool
; Supports Qualcomm EDL mode devices

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49F0-BC3D-A4FF138216D6}
Provider    = %ProviderName%
DriverVer   = 08/24/2026,1.0.0.0
CatalogFile = qcusb9008.cat

[Manufacturer]
%MfgName% = DeviceList, NTamd64, NTx86

[DeviceList.NTamd64]
%DeviceName% = USB_Install, USB\VID_05C6&PID_9008

[DeviceList.NTx86]
%DeviceName% = USB_Install, USB\VID_05C6&PID_9008

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{F72FE0D4-CBCB-407D-8814-9ED673D0DD6B}"

[Strings]
ProviderName = "Mooxy AI"
MfgName      = "Qualcomm Incorporated"
DeviceName   = "Qualcomm HS-USB QDLoader 9008"
